{
  "$defs": {
    "Ambiguous": {
      "additionalProperties": false,
      "description": "A name matched more than one taxon; the caller must choose one.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/AmbiguousCandidate"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "ambiguous",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "candidates"
      ],
      "title": "Ambiguous",
      "type": "object"
    },
    "AmbiguousCandidate": {
      "additionalProperties": false,
      "description": "One possible taxon when a name resolves to more than one.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "taxon_id": {
          "minLength": 1,
          "title": "Taxon Id",
          "type": "string"
        }
      },
      "required": [
        "taxon_id",
        "name"
      ],
      "title": "AmbiguousCandidate",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "What a calculation was about (ADR-009).\n\n``taxon_id`` and ``scope`` are ``None``/empty for calculations with\nno taxon (VPD from weather, temperature from elevation).\n``calculation`` is the stable name of the calculation function.\n``calculation_version`` is semver; starts at ``\"0.1.0\"`` for M10.",
      "properties": {
        "calculation": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Calculation",
          "type": "string"
        },
        "calculation_version": {
          "minLength": 1,
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Calculation Version",
          "type": "string"
        },
        "scope": {
          "additionalProperties": true,
          "title": "Scope",
          "type": "object"
        },
        "taxon_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxon Id"
        },
        "taxon_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxon Name"
        }
      },
      "required": [
        "calculation",
        "calculation_version"
      ],
      "title": "Subject",
      "type": "object"
    },
    "TaxonOk": {
      "additionalProperties": false,
      "description": "A name resolved to exactly one taxon.\n\n``status`` is always ``\"ok\"``. This is a **separate** success model from\n:class:`agri_core.models.result.Result` because ``Result`` carries a\nnumeric value; ``TaxonOk`` identifies a taxon. The two never appear in\nthe same union, so the ``status=\"ok\"`` collision is avoided by\nconstruction (``TaxonOutcome`` is a distinct discriminated union).",
      "properties": {
        "matched_via": {
          "enum": [
            "scientific_name",
            "accepted_name",
            "names"
          ],
          "title": "Matched Via",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rank": {
          "enum": [
            "species",
            "hybrid",
            "cultivar_group",
            "genus"
          ],
          "title": "Rank",
          "type": "string"
        },
        "scientific_name": {
          "minLength": 1,
          "title": "Scientific Name",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "taxon_id": {
          "minLength": 1,
          "title": "Taxon Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "taxon_id",
        "name",
        "matched_via",
        "scientific_name",
        "rank"
      ],
      "title": "TaxonOk",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "description": "The answer needs a value the profile marks as unknown.\n\nThis includes the case where no value covers the requested scope.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "unknown",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "ambiguous": "#/$defs/Ambiguous",
      "ok": "#/$defs/TaxonOk",
      "unknown": "#/$defs/Unknown"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TaxonOk"
    },
    {
      "$ref": "#/$defs/Ambiguous"
    },
    {
      "$ref": "#/$defs/Unknown"
    }
  ]
}
