{
  "additionalProperties": false,
  "description": "One row of ``datasets.csv``: an external dataset a fact cites.\n\n``license`` accepts SPDX-shaped identifiers, ``LicenseRef-<slug>`` for\ncustom licenses, or ``unclear`` when the license is unknown. Full SPDX\nmembership is checked at validate time against the manifest's\ndictionary_version, not here.",
  "properties": {
    "access_date": {
      "format": "date",
      "title": "Access Date",
      "type": "string"
    },
    "checksum": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^D[0-9A-HJKMNP-TV-Z]{9}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "license": {
      "title": "License",
      "type": "string"
    },
    "locator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locator"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "name",
    "version",
    "license",
    "checksum",
    "access_date"
  ],
  "title": "DatasetRow",
  "type": "object"
}
