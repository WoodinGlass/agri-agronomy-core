{
  "$defs": {
    "Ambiguous": {
      "additionalProperties": false,
      "description": "A name matched more than one taxon; the caller must choose one.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/AmbiguousCandidate"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "ambiguous",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "candidates"
      ],
      "title": "Ambiguous",
      "type": "object"
    },
    "AmbiguousCandidate": {
      "additionalProperties": false,
      "description": "One possible taxon when a name resolves to more than one.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "taxon_id": {
          "minLength": 1,
          "title": "Taxon Id",
          "type": "string"
        }
      },
      "required": [
        "taxon_id",
        "name"
      ],
      "title": "AmbiguousCandidate",
      "type": "object"
    },
    "CategoricalResult": {
      "additionalProperties": false,
      "description": "A successful calculation whose answer is a category, not a number.\n\n``status`` is always ``\"ok_category\"``. ``category`` is a stable code\n(e.g. ``\"optimal\"``); ``label`` is English display text and may change\nbetween minor releases. No unit, no ``capped`` -- categories carry\nneither. See ADR-006.\n\nConstruct through :func:`ok_category` rather than directly, so that\nthe ``status`` literal cannot be forgotten.",
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "category": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Category",
          "type": "string"
        },
        "evidence": {
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "ok_category",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "category",
        "label",
        "method",
        "provenance",
        "evidence",
        "assumptions",
        "warnings"
      ],
      "title": "CategoricalResult",
      "type": "object"
    },
    "InsufficientInput": {
      "additionalProperties": false,
      "description": "A required input is missing.\n\n``missing`` names each missing input in the caller's vocabulary (for\nexample ``\"temp_c\"`` or ``\"ec_to_ppm_factor (choose 0.5, 0.64 or 0.7)\"``).\nEach entry must be a non-empty string.",
      "properties": {
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "insufficient_input",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "missing"
      ],
      "title": "InsufficientInput",
      "type": "object"
    },
    "NotApplicable": {
      "additionalProperties": false,
      "description": "The question does not apply (no standard Kc, propagation method not used, etc.).",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "not_applicable",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "NotApplicable",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "description": "A structured warning or assumption attached to a result.\n\n``code`` is a stable snake_case identifier and part of the contract.\n``message`` is human-readable and may change between releases.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Notice",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a calculation's numbers came from.\n\n``fact_ids`` names the facts that contributed values.\n``pack_version`` is the version of the pack that supplied those facts;\nit is ``None`` when the calculation does not read a pack (for example,\nraw VPD from weather inputs).\n``pack_hash`` is the pack's ``content_hash`` (``sha256:<hex>``), which\npins the exact data used; it is ``None`` under the same conditions as\n``pack_version``.\n``source_ids`` lists the ``src`` IDs from ``sources.csv`` behind the\nvalues used.",
      "properties": {
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "pack_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Hash"
        },
        "pack_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Version"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ReferToAuthority": {
      "additionalProperties": false,
      "description": "The answer depends on a legal or regulatory authority; the caller must consult it.",
      "properties": {
        "flags": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "refer_to_authority",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "ReferToAuthority",
      "type": "object"
    },
    "ReferToLabel": {
      "additionalProperties": false,
      "description": "Pesticides are out of scope; the caller follows the label and local regulations.",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "refer_to_label",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "ReferToLabel",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "description": "A successful calculation.\n\n``status`` is always ``\"ok\"``. ``value`` is always finite: NaN and\ninfinity are rejected because they are not valid JSON. ``capped`` is\n``True`` when a safety cap limited ``value``.\n\nConstruct through the :func:`ok` factory rather than directly, so that\nthe ``status`` literal cannot be forgotten.",
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "capped": {
          "title": "Capped",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "value",
        "unit",
        "method",
        "provenance",
        "evidence",
        "assumptions",
        "warnings",
        "capped"
      ],
      "title": "Result",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "What a calculation was about (ADR-009).\n\n``taxon_id`` and ``scope`` are ``None``/empty for calculations with\nno taxon (VPD from weather, temperature from elevation).\n``calculation`` is the stable name of the calculation function.\n``calculation_version`` is semver; starts at ``\"0.1.0\"`` for M10.",
      "properties": {
        "calculation": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Calculation",
          "type": "string"
        },
        "calculation_version": {
          "minLength": 1,
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Calculation Version",
          "type": "string"
        },
        "scope": {
          "additionalProperties": true,
          "title": "Scope",
          "type": "object"
        },
        "taxon_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxon Id"
        },
        "taxon_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxon Name"
        }
      },
      "required": [
        "calculation",
        "calculation_version"
      ],
      "title": "Subject",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "description": "The answer needs a value the profile marks as unknown.\n\nThis includes the case where no value covers the requested scope.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "status": {
          "const": "unknown",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "ambiguous": "#/$defs/Ambiguous",
      "insufficient_input": "#/$defs/InsufficientInput",
      "not_applicable": "#/$defs/NotApplicable",
      "ok": "#/$defs/Result",
      "ok_category": "#/$defs/CategoricalResult",
      "refer_to_authority": "#/$defs/ReferToAuthority",
      "refer_to_label": "#/$defs/ReferToLabel",
      "unknown": "#/$defs/Unknown"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Result"
    },
    {
      "$ref": "#/$defs/CategoricalResult"
    },
    {
      "$ref": "#/$defs/InsufficientInput"
    },
    {
      "$ref": "#/$defs/Unknown"
    },
    {
      "$ref": "#/$defs/NotApplicable"
    },
    {
      "$ref": "#/$defs/ReferToLabel"
    },
    {
      "$ref": "#/$defs/Ambiguous"
    },
    {
      "$ref": "#/$defs/ReferToAuthority"
    }
  ]
}
