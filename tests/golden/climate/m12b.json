      "inputs": {
        "temp_max_c": 30.0,
        "temp_min_c": 20.0,
        "tbase_c": 10.0,
        "tupper_c": 22.0
      },
      "expected": 12.0,
      "tol_abs": 1e-06,
      "derivation": "mean = 25; min(25, 22) = 22; GDD = 22 - 10 = 12"
    }
  ],
